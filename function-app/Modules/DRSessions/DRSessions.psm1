Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function Stop-DRRequest {
    param([int]$StatusCode, [string]$Message)
    $exception = [System.InvalidOperationException]::new($Message)
    $exception.Data['HttpStatusCode'] = $StatusCode
    throw $exception
}

function ConvertTo-DRSessionId {
    param([AllowNull()][string]$SessionId)
    $parsed = [guid]::Empty
    if (-not [guid]::TryParseExact($SessionId, 'D', [ref]$parsed) -or $parsed -eq [guid]::Empty) {
        Stop-DRRequest 400 'sessionId is required and must be a nonempty UUID in xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx format, generated by the client.'
    }
    return $parsed.ToString('D')
}

function Assert-DRPrivateEndpoint {
    param([uri]$Endpoint)
    if ($Endpoint.Scheme -ne 'https') { throw 'Storage endpoints must use HTTPS.' }
    $addresses = @([System.Net.Dns]::GetHostAddresses($Endpoint.DnsSafeHost))
    if ($addresses.Count -eq 0) { throw "No DNS addresses found for '$($Endpoint.DnsSafeHost)'." }
    foreach ($address in $addresses) {
        $bytes = $address.GetAddressBytes()
        $private = $bytes.Length -eq 4 -and (
            $bytes[0] -eq 10 -or
            ($bytes[0] -eq 172 -and $bytes[1] -ge 16 -and $bytes[1] -le 31) -or
            ($bytes[0] -eq 192 -and $bytes[1] -eq 168))
        if (-not $private) {
            throw "Storage endpoint '$($Endpoint.DnsSafeHost)' does not resolve exclusively to private IPv4 addresses. Public fallback is forbidden."
        }
    }
}

function New-DRStorageClient {
    $blobEndpoint = [string]$env:CSV_STORAGE_CONNECTION__blobServiceUri
    $queueEndpoint = [string]$env:DR_QUEUE_CONNECTION__queueServiceUri
    foreach ($value in @($blobEndpoint, $queueEndpoint, $env:SOURCE_IDENTITY_CLIENT_ID, $env:HOSTING_SUBSCRIPTION_ID)) {
        if ([string]::IsNullOrWhiteSpace($value)) { throw 'Storage endpoints, source identity and hosting subscription must be configured.' }
    }
    Assert-DRPrivateEndpoint ([uri]$blobEndpoint)
    Assert-DRPrivateEndpoint ([uri]$queueEndpoint)
    Disable-AzContextAutosave -Scope Process | Out-Null
    $profile = (Connect-AzAccount -Identity -AccountId $env:SOURCE_IDENTITY_CLIENT_ID `
        -Subscription $env:HOSTING_SUBSCRIPTION_ID -SkipContextPopulation -Scope Process -ErrorAction Stop).Context
    return @{
        BlobEndpoint = $blobEndpoint.TrimEnd('/')
        QueueEndpoint = $queueEndpoint.TrimEnd('/')
        AccountName = ([uri]$blobEndpoint).DnsSafeHost.Split('.')[0]
        Container = [string]($env:SESSION_CONTAINER_NAME ?? 'dr-sessions')
        QueueName = [string]($env:DR_QUEUE_NAME ?? 'dr-activation')
        Profile = $profile
    }
}

function Invoke-DRStorageRequest {
    param(
        [hashtable]$Client, [string]$Method, [string]$Uri,
        [hashtable]$Headers = @{}, [AllowNull()][string]$Body,
        [string]$ContentType = 'application/json', [int[]]$AllowedStatus = @(200)
    )
    $access = Get-AzAccessToken -ResourceUrl 'https://storage.azure.com/' -DefaultProfile $Client.Profile -ErrorAction Stop
    $token = if ($access.Token -is [securestring]) { ConvertFrom-SecureString $access.Token -AsPlainText } else { [string]$access.Token }
    $requestHeaders = @{
        Authorization = "Bearer $token"
        'x-ms-version' = '2023-11-03'
        'x-ms-date' = [datetime]::UtcNow.ToString('R')
    }
    foreach ($key in $Headers.Keys) { $requestHeaders[$key] = $Headers[$key] }
    $arguments = @{
        Method = $Method; Uri = $Uri; Headers = $requestHeaders
        SkipHttpErrorCheck = $true; TimeoutSec = 60; ErrorAction = 'Stop'
    }
    if ($PSBoundParameters.ContainsKey('Body')) {
        $arguments.Body = [System.Text.Encoding]::UTF8.GetBytes($Body)
        $arguments.ContentType = $ContentType
    }
    try {
        $response = Invoke-WebRequest @arguments
        if ([int]$response.StatusCode -notin $AllowedStatus) {
            throw "Storage $Method failed with HTTP $([int]$response.StatusCode), code '$($response.Headers['x-ms-error-code'])'. Request ID: $($response.Headers['x-ms-request-id'])."
        }
        return $response
    }
    finally {
        $requestHeaders.Remove('Authorization')
        $token = $null
    }
}

function Get-DRBlobUri {
    param([hashtable]$Client, [string]$Container, [string]$Path)
    $encoded = ($Path.Split('/') | ForEach-Object { [uri]::EscapeDataString($_) }) -join '/'
    return "$($Client.BlobEndpoint)/$Container/$encoded"
}

function Get-DRResponseText {
    param([object]$Response)
    if ($Response.Content -is [byte[]]) { return [System.Text.Encoding]::UTF8.GetString($Response.Content) }
    return [string]$Response.Content
}

function Read-DRDocument {
    param([hashtable]$Client, [string]$Path)
    $response = Invoke-DRStorageRequest -Client $Client -Method GET `
        -Uri (Get-DRBlobUri $Client $Client.Container $Path) -AllowedStatus @(200, 404)
    if ([int]$response.StatusCode -eq 404) { return $null }
    return @{
        Value = ((Get-DRResponseText $response) | ConvertFrom-Json -AsHashtable -ErrorAction Stop)
        ETag = [string]@($response.Headers['ETag'])[0]
    }
}

function Write-DRDocument {
    param([hashtable]$Client, [string]$Path, [System.Collections.IDictionary]$Value, [string]$ETag, [switch]$CreateOnly)
    $headers = @{ 'x-ms-blob-type' = 'BlockBlob' }
    if ($CreateOnly) { $headers['If-None-Match'] = '*' }
    elseif ($ETag) { $headers['If-Match'] = $ETag }
    else { throw 'Session writes require create-only or ETag conditions.' }
    $allowed = if ($CreateOnly) { @(201, 409, 412) } else { @(201, 412) }
    $response = Invoke-DRStorageRequest -Client $Client -Method PUT `
        -Uri (Get-DRBlobUri $Client $Client.Container $Path) -Headers $headers `
        -Body ($Value | ConvertTo-Json -Depth 30 -Compress) -AllowedStatus $allowed
    if ([int]$response.StatusCode -eq 409) {
        $errorCode = [string]@($response.Headers['x-ms-error-code'])[0]
        if ($CreateOnly -and $errorCode -eq 'BlobAlreadyExists') { return $false }
        throw "Conditional session creation failed with HTTP 409, code '$errorCode'."
    }
    return [int]$response.StatusCode -eq 201
}

function Get-DRSessionState {
    param([hashtable]$Client, [string]$SessionId)
    return Read-DRDocument $Client "sessions/$SessionId/state.json"
}

function Get-DRPriorityReport {
    param([System.Collections.IDictionary]$State)
    $classes = @('sistemico', 'altamente-critico', 'critico', 'non-critico')
    $keys = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
    foreach ($row in $State.results) {
        if ($row.priorityClass -notin $classes -or [string]::IsNullOrWhiteSpace([string]$row.resourceKey) -or
            -not $keys.Add([string]$row.resourceKey)) {
            throw 'The stored session has invalid priority metadata or duplicate Azure resource keys.'
        }
    }
    $report = [ordered]@{
        id = [string]$State.sessionId
        activity = 'dr-activation'
        running = $(if ($State.status -in @('SUCCEEDED', 'FAILED')) { 'false' } else { 'true' })
    }
    foreach ($class in $classes) {
        $rows = @($State.results | Where-Object { $_.priorityClass -eq $class })
        $completed = [System.Collections.Generic.List[string]]::new()
        $pending = [System.Collections.Generic.List[string]]::new()
        $errors = [ordered]@{}
        foreach ($row in $rows) {
            $key = [string]$row.resourceKey
            switch ($row.status) {
                'SUCCEEDED' { $completed.Add($key) }
                'FAILED' {
                    $errors[$key] = if ([string]::IsNullOrWhiteSpace([string]$row.error)) {
                        'Failure recorded without a VM error detail. Inspect the session error and Azure stage logs.'
                    } else { [string]$row.error }
                }
                { $_ -in @('QUEUED', 'PREFLIGHT', 'PREFLIGHT_PASSED', 'RUNNING', 'NOT_STARTED') } { $pending.Add($key) }
                default { throw "Unsupported VM status '$($row.status)' in the priority report." }
            }
        }
        $report[$class] = [ordered]@{
            resource_completed = @($completed)
            resource_completed_count = [string]$completed.Count
            resource_pending = @($pending)
            resource_pending_count = [string]$pending.Count
            resource_error = $errors
            resource_error_count = [string]$errors.Count
            resource_total = [string]$rows.Count
        }
    }
    return $report
}

function Write-DRSessionState {
    param(
        [hashtable]$Client, [string]$SessionId, [System.Collections.IDictionary]$State,
        [string]$ETag, [switch]$CreateOnly
    )
    if ($State.schemaVersion -ge 2) {
        foreach ($entry in (Get-DRPriorityReport $State).GetEnumerator()) { $State[$entry.Key] = $entry.Value }
    }
    return Write-DRDocument $Client "sessions/$SessionId/state.json" $State -ETag $ETag -CreateOnly:$CreateOnly
}

function Update-DRSessionState {
    param(
        [hashtable]$Client, [string]$SessionId, [hashtable]$Changes,
        [string]$OwnerMessageId, [switch]$QueueConfirmed
    )
    for ($attempt = 0; $attempt -lt 5; $attempt++) {
        $record = Get-DRSessionState $Client $SessionId
        if ($null -eq $record) { throw "Session '$SessionId' has no persistent state." }
        $state = $record.Value
        if ($OwnerMessageId -and $state.messageId -ne $OwnerMessageId) {
            throw "Session '$SessionId' is owned by another queue message."
        }
        if ($QueueConfirmed) {
            $state.queueConfirmed = $true
            if (-not $state.acceptedAt) { $state.acceptedAt = [datetime]::UtcNow.ToString('o') }
            if ($state.status -in @('PENDING', 'SUBMISSION_UNKNOWN')) { $state.status = 'QUEUED' }
            $state.submissionError = $null
        }
        else {
            foreach ($key in $Changes.Keys) { $state[$key] = $Changes[$key] }
        }
        $state.updatedAt = [datetime]::UtcNow.ToString('o')
        if (Write-DRSessionState $Client $SessionId $state -ETag $record.ETag) { return $state }
        Write-Host "Session $SessionId changed concurrently; retrying the conditional state update."
    }
    throw "Session '$SessionId' state remained busy after five conditional writes."
}

function Get-DRReplicationSettings {
    $settings = @{
        BackendPoolNameOverride = [string]($env:BACKEND_POOL_NAME_OVERRIDE ?? '')
        LogContainerName = [string]($env:LOG_CONTAINER_NAME ?? 'dr-logs')
    }
    foreach ($entry in @{
        TargetSubscriptionSuffix = 'TARGET_SUBSCRIPTION_SUFFIX'
        TargetResourceGroupSuffix = 'TARGET_RESOURCE_GROUP_SUFFIX'
        TargetVnetNameSuffix = 'TARGET_VNET_NAME_SUFFIX'
        TargetVnetRgSuffix = 'TARGET_VNET_RG_SUFFIX'
        TargetLbNameSuffix = 'TARGET_LB_NAME_SUFFIX'
        TargetLbRgSuffix = 'TARGET_LB_RG_SUFFIX'
        TargetDesNameSuffix = 'TARGET_DES_NAME_SUFFIX'
        TargetDesRgSuffix = 'TARGET_DES_RG_SUFFIX'
        TargetAsgNameSuffix = 'TARGET_ASG_NAME_SUFFIX'
    }.GetEnumerator()) {
        $settings[$entry.Key] = [string][Environment]::GetEnvironmentVariable($entry.Value)
    }
    return $settings
}

function Resolve-DRCriticality {
    param([string]$Criticita)
    $normalized = ($Criticita.Trim() -replace '\s+', ' ').ToLowerInvariant()
    switch ($normalized) {
        { $_ -in @('sistemico (rto 2 ore)', 'sistemico (2h)') } { return @{ Class = 'sistemico'; Priority = 1 } }
        { $_ -in @('altamente critico (rto <= 48 ore)', 'altamente critico (4h adatto a rto 4 8 24 o 48h)') } {
            return @{ Class = 'altamente-critico'; Priority = 2 }
        }
        { $_ -in @('critico (rto da 72 a 360 ore)', 'critico (72h adatto a rto 72 120 o 360h)') } {
            return @{ Class = 'critico'; Priority = 3 }
        }
        { $_ -in @('non critico (best effort adatto a rto oltre le 360h)', 'non critico (rto oltre le 360 ore)') } {
            return @{ Class = 'non-critico'; Priority = 4 }
        }
        default { Stop-DRRequest 400 "Unsupported Criticita '$Criticita'. Use one of the documented customer RTO labels." }
    }
}

function Read-DRCsvRequest {
    param([hashtable]$Client, [string]$CsvBlobPath)
    if ([string]::IsNullOrWhiteSpace($CsvBlobPath) -or $CsvBlobPath.Length -gt 1024 -or
        @($CsvBlobPath.Split('/') | Where-Object { $_ -in @('', '.', '..') }).Count -gt 0 -or $CsvBlobPath.Contains('\')) {
        Stop-DRRequest 400 'csvBlobPath must identify a CSV blob using a relative path without empty, dot or parent segments.'
    }
    $container = [string]($env:CSV_CONTAINER_NAME ?? 'dr-configs')
    $response = Invoke-DRStorageRequest -Client $Client -Method GET `
        -Uri (Get-DRBlobUri $Client $container $CsvBlobPath) -AllowedStatus @(200, 404)
    if ([int]$response.StatusCode -eq 404) { Stop-DRRequest 404 'The requested CSV blob does not exist.' }
    $content = Get-DRResponseText $response
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($content)
    if ($bytes.Length -gt 1048576) { Stop-DRRequest 413 'CSV files must not exceed 1 MiB.' }
    try { $rows = @($content | ConvertFrom-Csv -ErrorAction Stop) }
    catch { Stop-DRRequest 400 'The CSV cannot be parsed.' }
    if ($rows.Count -eq 0 -or $rows.Count -gt 500) { Stop-DRRequest 400 'The CSV must contain between 1 and 500 VM rows.' }
    $columns = @('Criticita', 'Acronimo', 'SourceSubscription', 'SourceResourceGroup', 'SourceVmName')
    $actualColumns = @($rows[0].PSObject.Properties.Name)
    $normalizedColumns = @($actualColumns | ForEach-Object { $_.Trim().TrimStart([char]0xFEFF) -replace "^'(.*)'$", '$1' })
    if ($actualColumns.Count -ne $columns.Count -or
        ($normalizedColumns -join ',') -ine ($columns -join ',')) {
        Stop-DRRequest 400 'CSV columns must be Criticita,Acronimo,SourceSubscription,SourceResourceGroup,SourceVmName in that order.'
    }
    $valid = [System.Collections.Generic.List[object]]::new()
    $identities = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
    $rowNumber = 0
    foreach ($row in $rows) {
        $rowNumber++
        $values = @{}
        for ($columnIndex = 0; $columnIndex -lt $columns.Count; $columnIndex++) {
            $column = $columns[$columnIndex]
            $property = $row.PSObject.Properties[$actualColumns[$columnIndex]]
            if ($null -eq $property -or [string]::IsNullOrWhiteSpace([string]$property.Value)) {
                Stop-DRRequest 400 "CSV row $rowNumber requires all five columns; '$column' is missing."
            }
            $values[$column] = ([string]$property.Value).Trim()
            if ($column -in @('SourceSubscription', 'SourceResourceGroup', 'SourceVmName') -and
                ($values[$column].Contains('/') -or $values[$column].Contains('\'))) {
                Stop-DRRequest 400 "CSV column '$column' must not contain path separators."
            }
            if ($values[$column] -match '[\x00-\x1F\x7F]') { Stop-DRRequest 400 "CSV column '$column' must not contain control characters." }
        }
        $criticality = Resolve-DRCriticality $values.Criticita
        $values['PriorityClass'] = $criticality.Class
        $values['Priority'] = $criticality.Priority
        $values['CsvRow'] = $rowNumber
        $key = "$($values.SourceSubscription)/$($values.SourceResourceGroup)/$($values.SourceVmName)"
        if (-not $identities.Add($key)) { Stop-DRRequest 400 "The CSV contains a duplicate VM row: '$key'." }
        $values['ResourceKey'] = $key.ToLowerInvariant()
        $valid.Add($values)
    }
    return @{
        rows = @($valid | Sort-Object Priority, CsvRow -Stable)
        csvSha256 = [Convert]::ToHexString([System.Security.Cryptography.SHA256]::HashData($bytes)).ToLowerInvariant()
        csvETag = [string]@($response.Headers['ETag'])[0]
    }
}

function Register-DRSession {
    param([hashtable]$Client, [string]$SessionId, [string]$CsvBlobPath, [hashtable]$Csv)
    $manifest = [ordered]@{
        schemaVersion = 2; sessionId = $SessionId; csvBlobPath = $CsvBlobPath
        csvSha256 = $Csv.csvSha256; csvETag = $Csv.csvETag
        createdAt = [datetime]::UtcNow.ToString('o'); rows = @($Csv.rows)
        replicationSettings = Get-DRReplicationSettings
    }
    if (-not (Write-DRDocument $Client "sessions/$SessionId/request.json" $manifest -CreateOnly)) {
        $existing = Read-DRDocument $Client "sessions/$SessionId/request.json"
        if ($null -eq $existing) { throw 'The existing session manifest could not be read.' }
        if ($existing.Value.csvBlobPath -cne $CsvBlobPath -or $existing.Value.csvSha256 -ne $Csv.csvSha256) {
            Stop-DRRequest 409 'sessionId already belongs to a different CSV request. Use a new client-generated sessionId.'
        }
        $manifest = $existing.Value
    }
    $activationOrder = 0
    $state = [ordered]@{
        schemaVersion = $manifest.schemaVersion; sessionId = $SessionId; status = 'PENDING'; phase = 'Submission'
        createdAt = $manifest.createdAt; updatedAt = $manifest.createdAt; acceptedAt = $null
        startedAt = $null; completedAt = $null; queueConfirmed = $false; messageId = $null
        submissionError = $null; error = $null; requiresReview = $false
        csvBlobPath = $manifest.csvBlobPath; csvSha256 = $manifest.csvSha256
        results = @($manifest.rows | ForEach-Object {
            $activationOrder++
            $result = @{
                sourceSubscription = $_.SourceSubscription; sourceResourceGroup = $_.SourceResourceGroup
                vmName = $_.SourceVmName; sourceSubscriptionId = $null; targetSubscriptionId = $null
                status = 'QUEUED'; error = $null
            }
            if ($manifest.schemaVersion -ge 2) {
                $result['criticita'] = $_.Criticita; $result['acronimo'] = $_.Acronimo
                $result['priorityClass'] = $_.PriorityClass; $result['priority'] = $_.Priority
                $result['csvRow'] = $_.CsvRow; $result['activationOrder'] = $activationOrder
                $result['resourceKey'] = $_.ResourceKey
                $result['startedAt'] = $null; $result['completedAt'] = $null
            }
            $result
        })
    }
    $created = Write-DRSessionState $Client $SessionId $state -CreateOnly
    if (-not $created) { Write-Host "Session $SessionId already exists; preserving its stored state." }
    return (Get-DRSessionState $Client $SessionId).Value
}

function Submit-DRSession {
    param([hashtable]$Client, [string]$SessionId)
    $record = Get-DRSessionState $Client $SessionId
    if ($null -eq $record) { throw 'The session must be registered before queue submission.' }
    if ($record.Value.queueConfirmed -or $record.Value.status -in @('PREFLIGHT', 'RUNNING', 'SUCCEEDED', 'FAILED')) { return $record.Value }
    $message = @{ schemaVersion = 1; sessionId = $SessionId } | ConvertTo-Json -Compress
    $encoded = [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes($message))
    try {
        Invoke-DRStorageRequest -Client $Client -Method POST `
            -Uri "$($Client.QueueEndpoint)/$($Client.QueueName)/messages?messagettl=-1" `
            -ContentType 'application/xml' -Body "<QueueMessage><MessageText>$encoded</MessageText></QueueMessage>" `
            -AllowedStatus @(201) | Out-Null
    }
    catch {
        Write-Host "Queue acknowledgement failed for session ${SessionId}: $($_.Exception.Message)"
        Stop-DRRequest 503 'Queue acceptance could not be confirmed. Consult Get-DRStatus and retry the same sessionId; do not generate a replacement ID.'
    }
    return Update-DRSessionState -Client $Client -SessionId $SessionId -QueueConfirmed
}

function Get-DRSessionResponse {
    param([System.Collections.IDictionary]$State)
    $results = @($State.results)
    $response = [ordered]@{
        sessionId = $State.sessionId; status = $State.status; phase = $State.phase
        createdAt = $State.createdAt; acceptedAt = $State.acceptedAt; startedAt = $State.startedAt
        updatedAt = $State.updatedAt; completedAt = $State.completedAt
        queueConfirmed = $State.queueConfirmed; requiresReview = $State.requiresReview; error = $State.error
        csvBlobPath = $State.csvBlobPath; csvSha256 = $State.csvSha256; vmCount = $results.Count
        results = $results
        summary = @{
            succeeded = @($results | Where-Object status -eq 'SUCCEEDED').Count
            failed = @($results | Where-Object status -eq 'FAILED').Count
            inProgress = @($results | Where-Object status -in @('PREFLIGHT', 'RUNNING')).Count
            queued = @($results | Where-Object status -in @('QUEUED', 'PREFLIGHT_PASSED')).Count
            notStarted = @($results | Where-Object status -eq 'NOT_STARTED').Count
        }
    }
    if ($State.schemaVersion -ge 2) {
        $response['schemaVersion'] = $State.schemaVersion
        $response['platform'] = 'azure'
        foreach ($entry in (Get-DRPriorityReport $State).GetEnumerator()) { $response[$entry.Key] = $entry.Value }
    }
    return $response
}

Export-ModuleMember -Function Stop-DRRequest, ConvertTo-DRSessionId, New-DRStorageClient, Read-DRDocument, `
    Write-DRDocument, Get-DRSessionState, Update-DRSessionState, Read-DRCsvRequest, Register-DRSession, `
    Submit-DRSession, Get-DRSessionResponse, Resolve-DRCriticality, Write-DRSessionState
