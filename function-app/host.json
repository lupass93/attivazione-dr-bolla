{
  "version": "2.0",
  "functionTimeout": "-1",
  "concurrency": {
    "dynamicConcurrencyEnabled": false
  },
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxPollingInterval": "00:00:05",
      "visibilityTimeout": "00:01:00",
      "maxDequeueCount": 5,
      "messageEncoding": "base64"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Function": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": false
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "managedDependency": {
    "enabled": false
  }
}
